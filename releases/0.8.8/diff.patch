+  The sweep animates transform/opacity only, so it stays on the compositor: this skeleton is on
+  screen during the exact window the bundle is parsing and the configurator iframe is booting,
+  and a repainting animation would compete with them for the main thread.
+*/
+.ov25-price-skeleton {
+  display: flex;
+  align-items: center;
+}
+.ov25-price-skeleton__bar {
+  position: relative;
+  display: block;
+  overflow: hidden;
+  border-radius: 0.25em;
+  /* Fallback first: color-mix keeps the bar legible on light and dark themes alike. */
+  background-color: rgba(128, 128, 128, 0.18);
+  background-color: color-mix(in srgb, currentColor 15%, transparent);
