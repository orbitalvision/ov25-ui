+    height: 260px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .matrix-primary-button,
+  .matrix-icon-button,
+  .matrix-refresh-button,
+  .matrix-screenshot-button,
+  .matrix-expand-label,
+  .matrix-progress-track span {
+    transition-duration: 0ms;
+  }
+
+  .matrix-spinner {
+    animation-duration: 1.4s;
+  }
+}
