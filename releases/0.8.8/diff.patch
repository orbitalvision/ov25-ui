+  own line box reserves the height. Declared here rather than as Tailwind utilities because the
+  base rule above sets `position: relative` and, appended after the utility layer, would win.
+*/
+.ov25-price-skeleton__bar--overlay {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 50%;
+  height: 1em;
+  transform: translateY(-50%);
+}
+.ov25-price-skeleton__bar::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  transform: translateX(-100%);
+  background-image: linear-gradient(90deg, transparent, currentColor, transparent);
+  opacity: 0.12;
+  animation: ov25-price-skeleton-sweep 2.2s ease-in-out infinite;
+}
+/* Travels for 60% of the cycle, then rests: a continuous sweep across a bar this short reads as busy. */
+@keyframes ov25-price-skeleton-sweep {
+  0% { transform: translateX(-100%); }
+  60%, 100% { transform: translateX(100%); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ov25-price-skeleton__bar::after {
