+
+:where(.ov25-selection-details-surface[data-display-mode="tooltip"])
+  :where(.ov25-selection-details-description) {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+  overflow: visible;
+}
+
+:where(.ov25-selection-details-surface[data-display-mode="tooltip"])
+  :where(.ov25-selection-details-description + .ov25-selection-details-metadata) {
+  margin-top: 8px;
+}
