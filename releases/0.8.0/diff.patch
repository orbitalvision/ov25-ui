+    triggerStyle: { desktop: 'single-button', mobile: 'single-button' },
+    variants: {
+      displayMode: { desktop: 'tree', mobile: 'list' },
+      useSimpleVariantsSelector: true,
+    },
+  },
+  flags: {
+    hidePricing: false,
+    disableAddToCart: false,
+    disableBuyNow: false,
+    hideAr: false,
+    deferThreeD: false,
+    showOptional: false,
+    forceMobile: false,
+    autoOpen: false,
