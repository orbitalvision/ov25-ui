+          <a href="#delivery">Visit us</a>
+        </nav>
+      </header>
+    </div>
+  );
+}
+
+function ThemeHeader() {
+  if (scenario.header === 'fixed') return <FixedHeader />;
+  if (scenario.header === 'collapsing') return <CollapsingHeader />;
+  return null;
+}
