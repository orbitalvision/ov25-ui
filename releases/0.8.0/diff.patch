+  it('uses production when local preview is explicitly disabled', () => {
+    expect(resolvePreviewIframeSrc(undefined, false, 'localhost')).toBe(
+      CONFIGURATOR_PREVIEW_PRODUCTION_BASE_URL,
+    );
+  });
+
