+type RectInput = {
+  top: number;
+  left?: number;
+  width?: number;
+  height: number;
+};
+
+function rect(input: RectInput): DOMRect {
+  const left = input.left ?? 0;
+  const width = input.width ?? 1200;
+  return {
+    x: left,
+    y: input.top,
+    top: input.top,
+    left,
+    width,
+    height: input.height,
+    right: left + width,
+    bottom: input.top + input.height,
