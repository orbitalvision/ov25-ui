+const getString = (_key: string, _values?: Record<string, string | number | null | undefined>, fallback?: string) => fallback ?? '';
+
+const swatch: Swatch = {
+  manufacturerId: 7,
+  name: 'Dove',
+  option: 'Fabric',
+  material: {
+    id: 9,
+    name: 'Dove Linen',
+    type: 'Fabric',
+    range: 'Heritage',
