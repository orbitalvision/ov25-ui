+/*
+ * Selection details defaults intentionally use zero specificity. Configurator
+ * Setup appends client Element Styles after this shared sheet, so its ordinary
+ * class selectors can override these visual defaults without `!important`.
+ * Runtime-computed position and animation values remain inline.
+ */
+:where(.ov25-selection-details-surface) {
+  position: fixed;
+  box-sizing: border-box;
+  overflow-wrap: anywhere;
+  word-break: break-word;
+  pointer-events: auto;
+}
+
+:where(.ov25-selection-details-surface[data-interactive="false"]) {
+  pointer-events: none;
+}
+
+:where(.ov25-selection-details-surface[data-display-mode="tooltip"]) {
+  height: min(360px, max(1px, calc(100dvh - 24px)));
+  max-height: calc(100dvh - 24px);
+  border-radius: 0;
+  border-color: var(--ov25-border-color);
+  box-shadow: none;
+  transform-origin: right center;
+}
+
+:where(.ov25-selection-details-surface[data-display-mode="sheet"]) {
+  inset-block: 0;
+  right: 0;
+  width: 384px;
+  height: 100dvh;
+  border-radius: 0;
+  border-width: 0;
+  border-left-width: 1px;
+}
+
+:where(.ov25-selection-details-surface[data-display-mode="sheet"][data-mobile="true"]) {
+  width: 100dvw;
+}
+
+:where(.ov25-selection-details-surface[data-display-mode="fullscreen"]) {
+  inset: 0;
+  width: 100dvw;
+  height: 100dvh;
+  border-radius: 0;
+  border-width: 0;
+}
+
