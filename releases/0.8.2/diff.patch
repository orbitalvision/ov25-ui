+              disabled={isApplied || appliedRequestRef.current === rendered.requestId}
+              onClick={handleApply}
+            >
+              {isApplied
+                ? getString('selectionDetailsApplied', undefined, 'Applied')
+                : getString('selectionDetailsApply', undefined, 'Apply to Model')}
+            </Button>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
