+                variant="outline"
+                className={`ov25-selection-details-swatch-toggle ${actionButtonWidthClass} ov:border-(--ov25-border-color) ov:rounded-none ov:bg-transparent ov:text-(--ov25-text-color) ov:transition-none`}
