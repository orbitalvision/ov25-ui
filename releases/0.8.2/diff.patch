+      BODY_MOBILE_DRAWER_PORTAL_Z_INDEX,
+    );
+    expect(BODY_MOBILE_GALLERY_Z_INDEX).toBeLessThan(
+      BODY_MOBILE_DRAWER_PORTAL_Z_INDEX,
